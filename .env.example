# ClipHunter configuration. Copy to `.env` for local development.
# In production the file lives at /var/www/cliphunter/shared/.env (0640 root:cliphunter).
# Never commit a real `.env`.

# production | development | testing
APP_ENV=development
# Must be false in production: errors never expose stack traces or paths to clients.
APP_DEBUG=true
APP_URL=http://localhost:8080
# 64 hex chars. Used to HMAC client IPs in logs and rate-limit keys.
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Binaries (absolute paths in production)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Runtime storage (outside the web root). Relative paths resolve against the project root.
STORAGE_PATH=storage

# Media limits
MAX_FILE_SIZE_MB=1024
MAX_VIDEO_DURATION_SEC=7200
MAX_VIDEO_HEIGHT=2160

# Timeouts
ANALYZE_TIMEOUT_SEC=30
DOWNLOAD_TIMEOUT_SEC=900

# Concurrency and queue
MAX_CONCURRENT_ANALYZE=2
MAX_CONCURRENT_DOWNLOADS=1
MAX_QUEUE_LENGTH=10
MAX_ACTIVE_JOBS_PER_IP=1

# Per-IP rate limits: <requests>/<window seconds>
RATE_LIMIT_ANALYZE=20/600
RATE_LIMIT_DOWNLOADS=10/3600

# Storage capacity and retention
STORAGE_QUOTA_MB=4096
MIN_FREE_DISK_MB=1536
FILE_RETENTION_MIN=30
ANALYSIS_TTL_MIN=30
JOB_TTL_HOURS=24

# debug | info | notice | warning | error
LOG_LEVEL=debug
